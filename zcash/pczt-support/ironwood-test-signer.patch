+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn explicit_expiry_preserves_the_bounded_window_before_pczt_finalization() {
+        assert_eq!(bounded_expiry(4_620_200,Some(120)).unwrap(),Some(BlockHeight::from_u32(4_620_320)));
+        assert_eq!(bounded_expiry(4_620_200,Some(40)).unwrap(),Some(BlockHeight::from_u32(4_620_240)));
+        assert_eq!(bounded_expiry(4_620_200,None).unwrap(),None);
+    }
+    #[test]
+    fn unsupported_expiry_windows_and_height_overflow_are_rejected() {
+        for blocks in [0,39,121,u32::MAX] { assert!(bounded_expiry(4_620_200,Some(blocks)).is_err()); }
+        for target in [0,499_999_900,500_000_000,u32::MAX] { assert!(bounded_expiry(target,Some(120)).is_err()); }
+    }
+}
