+fn bounded_expiry(target: u32, blocks: Option<u32>) -> Result<Option<BlockHeight>, anyhow::Error> {
+    let Some(blocks) = blocks else { return Ok(None); };
+    if !(40..=120).contains(&blocks) || target==0 || target>=500_000_000 {
+        return Err(anyhow!("Expiry must be between 40 and 120 blocks from a valid proposal target"));
+    }
+    let height = target.checked_add(blocks).filter(|height|*height<500_000_000)
+        .ok_or_else(||anyhow!("The requested transaction expiry exceeds the supported block-height range"))?;
+    Ok(Some(BlockHeight::from_u32(height)))
+}
